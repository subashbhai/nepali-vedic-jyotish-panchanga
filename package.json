{
  "name": "nepali-vedic-jyotish-panchanga",
  "productName": "नेपाली वैदिक ज्योतिष तथा पञ्चाङ्ग",
  "description": "नेपाली वैदिक ज्योतिष, पञ्चाङ्ग, कुण्डली तथा वास्तु सेवा प्रणाली",
  "author": "Balananda Jyotish <subashbhai@gmail.com>",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs dist_electron",
    "lint": "tsc --noEmit",
    "desktop:dev": "electron electron/main.cjs",
    "desktop:build": "vite build && electron-builder --win",
    "desktop:build-portable": "vite build && electron-builder --win portable",
    "desktop:build-mac": "vite build && electron-builder --mac",
    "desktop:pack": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nepali-date-converter": "^3.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "electron": "35.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.balananda.jyotish",
    "productName": "नेपाली वैदिक ज्योतिष तथा पञ्चाङ्ग",
    "electronVersion": "35.0.0",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "subashbhai",
      "repo": "nepali-vedic-jyotish-panchanga"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/logo.png",
      "category": "public.app-category.lifestyle"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "नेपाली वैदिक ज्योतिष"
    }
  }
}
