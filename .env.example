# ===================================================================
# बालानन्द वैदिक ज्योतिष सेवा - Environment Configuration Template
# ===================================================================

# 1. AI Engine Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# 2. SMS Provider Configuration
# Options: sparrow (Nepal official) | twilio | webhook | mock (Development)
# Note: If SPARROW_SMS_TOKEN is set, provider automatically activates 'sparrow'.
SMS_PROVIDER="mock"

# 2.1 Sparrow SMS (नेपालको आधिकारिक SMS गेटवे)
# Obtain token from: https://sparrowsms.com
SPARROW_SMS_TOKEN="your_sparrow_sms_token"
SPARROW_SMS_FROM="TheAlert"

# 2.2 Twilio SMS (International Gateway)
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_token"
TWILIO_PHONE_NUMBER="+1234567890"

# 2.3 Custom SMS Webhook
SMS_WEBHOOK_URL="https://your-sms-webhook.com/api/send"
SMS_WEBHOOK_BEARER="optional_bearer_token"

# 3. Email Provider Configuration
# Options: resend (Recommended) | sendgrid | mock (Development)
# Note: If RESEND_API_KEY is set, provider automatically activates 'resend'.
EMAIL_PROVIDER="mock"

# 3.1 Resend Email Gateway (Fast, high delivery rate)
# Obtain free API key from: https://resend.com
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="Balananda Jyotish <onboarding@resend.dev>"

# 3.2 SendGrid Email Gateway
SENDGRID_API_KEY="your_sendgrid_api_key"

