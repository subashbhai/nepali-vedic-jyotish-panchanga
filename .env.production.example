# ==============================================================================
# Balananda Vaidik Sewa — Production Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS OR SENSITIVE URLS TO SOURCE CONTROL
# ==============================================================================

# 1. Environment & Network Configuration
NODE_ENV=production
PORT=8080

# 2. Authoritative PostgreSQL Database URL
# Example: postgres://balananda_user:your_password@ep-cool-fog-123456.ap-southeast-1.aws.neon.tech/balananda?sslmode=require
DATABASE_URL="postgres://username:password@host:5432/balananda?sslmode=require"

# 3. Super Admin & Cron Secrets (Used for administrative server-to-server calls)
# Generate a cryptographically random string (e.g. openssl rand -hex 32)
SUPERADMIN_SECRET="generate_a_secure_random_hex_key_here"
CRON_SECRET="generate_a_secure_random_hex_key_here"

# 4. Frontend API Connection URL (Used during Vite build to point frontend to this backend)
# Example: https://balananda-api.onrender.com or https://balananda-api-xxxxx-as.a.run.app
VITE_API_URL="https://YOUR-DEPLOYED-BACKEND-DOMAIN.com"
